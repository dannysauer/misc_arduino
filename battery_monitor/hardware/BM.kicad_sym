(kicad_symbol_lib (version 20231120) (generator "battery_monitor_generator")
  (symbol "R"
    (pin_names (offset 0.8))
    (in_bom yes)
    (on_board yes)
    (property "Reference" "R" (at 0 3.81 0) (effects (font (size 1.0 1.0))))
    (property "Value" "R" (at 0 -3.81 0) (effects (font (size 1.0 1.0))))
    (property "Footprint" "" (at 0 0 0) (effects (font (size 0.8 0.8)) hide))
    (property "Datasheet" "" (at 0 0 0) (effects (font (size 0.8 0.8)) hide))
    (property "Description" "Resistor" (at 0 0 0) (effects (font (size 0.8 0.8)) hide))
  )
)
